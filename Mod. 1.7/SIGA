<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SIGA | Automatización de Procesos</title>

<style>



html{
    scroll-behavior:smooth;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f7f7f7;
    color:#333;
    overflow-x:hidden;
}




header{
    background:rgba(110,13,37,.97);
    color:white;

    padding:18px 50px;

    display:flex;
    justify-content:space-between;
    align-items:center;

    position:sticky;
    top:0;

    z-index:1000;

    box-shadow:0 4px 20px rgba(0,0,0,.2);
}

.logo{
    font-size:34px;
    font-weight:bold;
    letter-spacing:3px;

    transition:.3s;
}

.logo:hover{
    transform:scale(1.08);
    text-shadow:0 0 15px rgba(255,255,255,.7);
}




nav{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;

    margin-left:18px;

    font-weight:bold;
    font-size:14px;

    position:relative;

    transition:.3s;
}

nav a::after{

    content:"";

    position:absolute;

    left:0;
    bottom:-7px;

    width:0;
    height:2px;

    background:#ffd6df;

    transition:.3s;
}

nav a:hover{
    color:#ffd6df;
}

nav a:hover::after{
    width:100%;
}




.hero{

    min-height:85vh;

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;

    color:white;

    position:relative;

    background-size:cover;
    background-position:center;

    animation:carruselSIGA 20s infinite;

    overflow:hidden;
}

.hero::before{

    content:"";

    position:absolute;

    inset:0;

    background:
    linear-gradient(
        135deg,
        rgba(110,13,37,.90),
        rgba(40,5,15,.65)
    );
}

.hero::after{

    content:"";

    position:absolute;

    width:500px;
    height:500px;

    border:2px solid rgba(255,255,255,.15);

    border-radius:50%;

    right:-180px;
    bottom:-220px;

    box-shadow:
    0 0 0 40px rgba(255,255,255,.04),
    0 0 0 80px rgba(255,255,255,.03);
}

.hero .contenido{

    position:relative;

    z-index:2;

    max-width:900px;

    padding:30px;

    animation:aparecer 1.5s ease;
}

.hero h1{

    font-size:60px;

    margin-bottom:20px;

    letter-spacing:1px;

    text-shadow:
    0 5px 20px rgba(0,0,0,.4);
}

.hero p{

    font-size:21px;

    line-height:1.7;

    margin-bottom:35px;

    color:#f9e9ed;
}




@keyframes carruselSIGA{

    0%,25%{
        background-image:url("siga logo.jpeg");
    }

    26%,50%{
        background-image:url("siga foto 2.jpeg");
    }

    51%,75%{
        background-image:url("siga foto 3.jpeg");
    }

    76%,100%{
        background-image:url("siga foto 4.jpeg");
    }
}




@keyframes aparecer{

    from{
        opacity:0;
        transform:translateY(40px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes flotar{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-10px);
    }
}




.boton{

    display:inline-block;

    background:white;

    color:#6E0D25;

    padding:16px 38px;

    border-radius:50px;

    text-decoration:none;

    font-weight:bold;

    font-size:16px;

    box-shadow:
    0 8px 25px rgba(0,0,0,.25);

    transition:.4s;
}

.boton:hover{

    background:#ffdce5;

    transform:
    translateY(-5px)
    scale(1.05);

    box-shadow:
    0 12px 30px rgba(0,0,0,.35);
}




section{
    padding:80px 8%;
}

h2{

    color:#6E0D25;

    text-align:center;

    margin-bottom:30px;

    font-size:38px;

    position:relative;
}

h2::after{

    content:"";

    display:block;

    width:70px;
    height:4px;

    background:#6E0D25;

    margin:12px auto;

    border-radius:10px;
}

.descripcion{

    max-width:1100px;

    margin:auto;

    text-align:center;

    line-height:1.9;

    font-size:18px;

    color:#555;
}

.subtitulo{

    max-width:700px;

    margin:0 auto 45px;

    text-align:center;

    color:#777;

    font-size:17px;

    line-height:1.7;
}

.etiqueta-seccion{

    display:block;

    width:max-content;

    margin:0 auto 10px;

    color:#6E0D25;

    font-size:13px;

    font-weight:bold;

    letter-spacing:2px;
}




.bloque-nosotros{

    max-width:1150px;

    margin:50px auto 0;

    display:grid;

    grid-template-columns:2fr 1fr;

    gap:50px;

    align-items:center;
}

.texto-nosotros{

    font-size:18px;

    line-height:1.8;

    color:#555;
}

.texto-nosotros p{
    margin-bottom:18px;
}

.tarjeta-destacada{

    background:
    linear-gradient(
        145deg,
        #6E0D25,
        #9c2749
    );

    color:white;

    padding:45px 30px;

    border-radius:25px;

    text-align:center;

    box-shadow:
    0 20px 40px rgba(110,13,37,.25);

    transition:.4s;
}

.tarjeta-destacada:hover{

    transform:
    translateY(-10px)
    rotate(1deg);
}

.icono-grande{

    font-size:65px;

    margin-bottom:20px;

    animation:
    flotar 3s ease-in-out infinite;
}

.tarjeta-destacada h3{

    font-size:25px;

    margin-bottom:15px;
}

.tarjeta-destacada p{

    line-height:1.7;

    color:#f9e9ed;
}




.seccion-vino{

    background:
    linear-gradient(
        135deg,
        #6E0D25,
        #400816
    );

    color:white;

    position:relative;

    overflow:hidden;
}

.seccion-vino::before{

    content:"";

    position:absolute;

    width:400px;
    height:400px;

    border:2px solid rgba(255,255,255,.08);

    border-radius:50%;

    right:-150px;
    top:-150px;
}

.contenedor-objetivo{

    max-width:1100px;

    margin:auto;

    display:grid;

    grid-template-columns:150px 1fr;

    gap:40px;

    align-items:center;

    position:relative;

    z-index:2;
}

.numero{

    font-size:80px;

    font-weight:bold;

    color:rgba(255,255,255,.20);
}

.seccion-vino h2{

    color:white;

    text-align:left;

    margin-bottom:25px;
}

.seccion-vino h2::after{

    margin-left:0;

    background:white;
}

.texto-claro{

    color:#f9e9ed;

    font-size:18px;

    line-height:1.8;

    margin-bottom:20px;
}




.contenedor{

    display:flex;

    gap:30px;

    flex-wrap:wrap;

    justify-content:center;

    margin-top:40px;
}

.tarjeta{

    flex:1;

    min-width:260px;

    max-width:500px;

    background:white;

    padding:35px;

    border-radius:20px;

    box-shadow:
    0 10px 30px rgba(0,0,0,.10);

    transition:.4s;

    border:1px solid #eee;

    position:relative;

    overflow:hidden;
}

.tarjeta::before{

    content:"";

    position:absolute;

    top:0;
    left:0;

    width:100%;
    height:5px;

    background:#6E0D25;
}

.tarjeta:hover{

    transform:
    translateY(-12px)
    scale(1.02);

    box-shadow:
    0 20px 40px rgba(110,13,37,.20);
}

.tarjeta h3{

    color:#6E0D25;

    margin-bottom:18px;

    font-size:23px;
}

.tarjeta p{

    line-height:1.8;

    color:#555;
}

.especial{

    text-align:center;

    min-height:300px;

    padding:40px 30px;
}

.icono-tarjeta{

    width:75px;
    height:75px;

    margin:0 auto 20px;

    display:flex;

    align-items:center;
    justify-content:center;

    background:#f7e5e9;

    border-radius:50%;

    font-size:35px;

    transition:.4s;
}

.especial:hover .icono-tarjeta{

    transform:
    rotate(10deg)
    scale(1.15);
}




.idea{

    background:#f1e7ea;

    position:relative;

    overflow:hidden;
}

.idea-contenido{

    max-width:950px;

    margin:auto;

    text-align:center;

    position:relative;

    z-index:2;
}

.etiqueta{

    display:inline-block;

    background:#6E0D25;

    color:white;

    padding:8px 18px;

    border-radius:30px;

    font-size:13px;

    font-weight:bold;

    letter-spacing:2px;

    margin-bottom:15px;
}

.idea h2{
    margin-bottom:30px;
}

.idea p{

    font-size:18px;

    line-height:1.8;

    color:#555;

    margin-bottom:18px;
}

.mini-beneficios{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:15px;

    margin-top:40px;
}

.mini-beneficios div{

    background:white;

    padding:20px 10px;

    border-radius:15px;

    box-shadow:
    0 5px 15px rgba(0,0,0,.08);

    transition:.3s;
}

.mini-beneficios div:hover{

    transform:translateY(-7px);

    box-shadow:
    0 12px 25px rgba(110,13,37,.15);
}

.mini-beneficios span{

    display:block;

    font-size:30px;

    margin-bottom:8px;
}

.mini-beneficios strong{
    color:#6E0D25;
}




.seccion-valores{

    background:white;

    text-align:center;
}

.grid-valores{

    max-width:1150px;

    margin:auto;

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:25px;
}

.valor-card{

    background:#fff;

    border:1px solid #eee;

    border-radius:20px;

    padding:30px 25px;

    text-align:center;

    position:relative;

    overflow:hidden;

    transition:.4s;

    box-shadow:
    0 8px 25px rgba(0,0,0,.07);
}

.valor-card::before{

    content:"";

    position:absolute;

    left:0;
    top:0;

    width:100%;
    height:4px;

    background:#6E0D25;

    transform:scaleX(0);

    transform-origin:left;

    transition:.4s;
}

.valor-card:hover::before{
    transform:scaleX(1);
}

.valor-card:hover{

    transform:translateY(-10px);

    box-shadow:
    0 18px 35px rgba(110,13,37,.15);
}

.valor-card span{

    display:flex;

    width:65px;
    height:65px;

    margin:0 auto 18px;

    align-items:center;
    justify-content:center;

    background:#f8e9ed;

    border-radius:50%;

    font-size:30px;

    transition:.4s;
}

.valor-card:hover span{

    transform:
    rotate(8deg)
    scale(1.12);
}

.valor-card h3{

    color:#6E0D25;

    font-size:21px;

    margin-bottom:12px;
}

.valor-card p{

    color:#666;

    line-height:1.7;

    font-size:15px;
}




.seccion-principios{

    background:
    linear-gradient(
        135deg,
        #faf3f5,
        #f4e6ea
    );

    text-align:center;
}

.principios-contenido{

    max-width:1000px;

    margin:auto;
}

.timeline{

    position:relative;

    max-width:800px;

    margin:50px auto 0;

    text-align:left;
}

.timeline::before{

    content:"";

    position:absolute;

    left:35px;

    top:0;
    bottom:0;

    width:3px;

    background:#6E0D25;

    opacity:.25;
}

.principio{

    display:flex;

    align-items:center;

    gap:30px;

    margin-bottom:30px;

    position:relative;
}

.principio-numero{

    min-width:72px;

    height:72px;

    border-radius:50%;

    background:#6E0D25;

    color:white;

    display:flex;

    align-items:center;

    justify-content:center;

    font-weight:bold;

    position:relative;

    z-index:2;

    box-shadow:
    0 8px 20px rgba(110,13,37,.25);
}

.principio-texto{

    flex:1;

    background:white;

    padding:22px 25px;

    border-radius:15px;

    box-shadow:
    0 5px 20px rgba(0,0,0,.07);

    transition:.3s;
}

.principio-texto:hover{

    transform:translateX(8px);

    box-shadow:
    0 10px 25px rgba(110,13,37,.12);
}

.principio-texto h3{

    color:#6E0D25;

    margin-bottom:8px;

    font-size:20px;
}

.principio-texto p{

    color:#666;

    line-height:1.6;
}




.seccion-beneficios{

    background:white;

    text-align:center;
}

.beneficios-grid{

    max-width:1150px;

    margin:auto;

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:25px;
}

.beneficio-card{

    background:
    linear-gradient(
        160deg,
        #ffffff,
        #faf3f5
    );

    border-radius:22px;

    padding:35px 25px;

    text-align:left;

    position:relative;

    overflow:hidden;

    border:1px solid #eee;

    transition:.4s;
}

.beneficio-card:hover{

    transform:translateY(-12px);

    box-shadow:
    0 20px 40px rgba(110,13,37,.15);
}

.beneficio-icono{

    width:70px;
    height:70px;

    display:flex;

    align-items:center;
    justify-content:center;

    background:#6E0D25;

    color:white;

    border-radius:18px;

    font-size:32px;

    margin-bottom:25px;

    transition:.4s;
}

.beneficio-card:hover .beneficio-icono{

    transform:
    rotate(-5deg)
    scale(1.1);
}

.beneficio-numero{

    position:absolute;

    top:20px;
    right:20px;

    font-size:45px;

    font-weight:bold;

    color:rgba(110,13,37,.08);
}

.beneficio-card h3{

    color:#6E0D25;

    font-size:21px;

    margin-bottom:15px;
}

.beneficio-card p{

    color:#666;

    line-height:1.7;

    font-size:15px;
}




.redes-modernas{

    background:
    linear-gradient(
        135deg,
        #6E0D25,
        #3d0715
    );

    color:white;

    text-align:center;

    position:relative;

    overflow:hidden;
}

.redes-modernas::before{

    content:"";

    position:absolute;

    width:350px;
    height:350px;

    border:2px solid rgba(255,255,255,.08);

    border-radius:50%;

    left:-150px;
    top:-150px;
}

.redes-contenido{

    position:relative;

    z-index:2;

    max-width:800px;

    margin:auto;
}

.etiqueta-redes{

    display:inline-block;

    padding:8px 18px;

    border:1px solid rgba(255,255,255,.3);

    border-radius:30px;

    font-size:13px;

    letter-spacing:2px;

    margin-bottom:15px;
}

.redes-modernas h2{

    color:white;

    margin-bottom:15px;
}

.redes-modernas h2::after{
    background:white;
}

.redes-modernas p{

    color:#f5dfe5;

    line-height:1.7;

    font-size:17px;
}

.redes-iconos{

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

    margin-top:35px;
}

.red{

    width:65px;
    height:65px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:50%;

    background:rgba(255,255,255,.12);

    border:1px solid rgba(255,255,255,.25);

    color:white;

    text-decoration:none;

    transition:.4s;
}

.red span{

    font-size:25px;

    font-weight:bold;
}

.red:hover{

    transform:
    translateY(-8px)
    scale(1.1);

    background:white;

    color:#6E0D25;

    box-shadow:
    0 10px 25px rgba(0,0,0,.25);
}




.contacto-moderno{

    background:#fafafa;

    text-align:center;
}

.contacto-grid{

    max-width:1000px;

    margin:40px auto;

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:25px;
}

.contacto-card{

    background:white;

    padding:35px 25px;

    border-radius:20px;

    border:1px solid #eee;

    box-shadow:
    0 8px 25px rgba(0,0,0,.07);

    transition:.4s;
}

.contacto-card:hover{

    transform:translateY(-10px);

    box-shadow:
    0 18px 35px rgba(110,13,37,.15);
}

.contacto-icono{

    width:75px;
    height:75px;

    margin:0 auto 20px;

    display:flex;

    align-items:center;
    justify-content:center;

    background:#f8e9ed;

    border-radius:50%;

    font-size:32px;

    transition:.4s;
}

.contacto-card:hover .contacto-icono{

    background:#6E0D25;

    transform:scale(1.1);
}

.contacto-card h3{

    color:#6E0D25;

    margin-bottom:12px;

    font-size:20px;
}

.contacto-card p{

    color:#666;

    line-height:1.7;
}

.boton-contacto{

    display:inline-block;

    margin-top:15px;

    padding:15px 35px;

    border-radius:50px;

    background:#6E0D25;

    color:white;

    text-decoration:none;

    font-weight:bold;

    transition:.4s;

    box-shadow:
    0 8px 20px rgba(110,13,37,.25);
}

.boton-contacto:hover{

    transform:
    translateY(-5px);

    background:#8f1738;

    box-shadow:
    0 12px 30px rgba(110,13,37,.35);
}




.llamada-final{

    padding:90px 20px;

    text-align:center;

    color:white;

    background:
    linear-gradient(
        135deg,
        #400816,
        #6E0D25,
        #9c2749
    );
}

.llamada-final span{

    font-size:18px;

    font-weight:bold;

    letter-spacing:5px;

    opacity:.8;
}

.llamada-final h2{

    color:white;

    font-size:42px;

    max-width:800px;

    margin:15px auto;
}

.llamada-final h2::after{
    background:white;
}

.llamada-final p{

    font-size:20px;

    color:#f7dfe5;

    margin-bottom:30px;
}

.boton-final{

    display:inline-block;

    padding:15px 35px;

    background:white;

    color:#6E0D25;

    border-radius:50px;

    text-decoration:none;

    font-weight:bold;

    transition:.4s;
}

.boton-final:hover{

    transform:
    translateY(-5px)
    scale(1.05);

    background:#ffe8ee;
}




.footer-moderno{

    background:#25030c;

    color:white;

    text-align:center;

    padding:40px 20px;

    margin:0;
}

.footer-logo{

    font-size:35px;

    font-weight:bold;

    letter-spacing:5px;

    margin-bottom:10px;
}

.footer-contenido > p{

    color:#d9bfc6;

    font-size:15px;
}

.footer-linea{

    width:80px;

    height:2px;

    background:#6E0D25;

    margin:25px auto;
}

.copyright{

    font-size:13px !important;

    color:#9f858d !important;
}




@media(max-width:1000px){

    header{

        padding:18px 25px;

    }

    nav a{

        margin-left:10px;

        font-size:13px;

    }

    .hero h1{

        font-size:48px;

    }

    .grid-valores{

        grid-template-columns:
        repeat(2,1fr);

    }

    .beneficios-grid{

        grid-template-columns:
        repeat(2,1fr);

    }

}




@media(max-width:768px){

    header{

        flex-direction:column;

        gap:15px;

    }

    nav{

        width:100%;

    }

    nav a{

        display:inline-block;

        margin:7px;

    }

    .hero{

        min-height:75vh;

    }

    .hero h1{

        font-size:38px;

    }

    .hero p{

        font-size:18px;

    }

    section{

        padding:60px 20px;

    }

    h2{

        font-size:31px;

    }

    .bloque-nosotros{

        grid-template-columns:1fr;

        gap:30px;

    }

    .contenedor-objetivo{

        grid-template-columns:1fr;

        text-align:center;

    }

    .numero{

        font-size:55px;

    }

    .seccion-vino h2{

        text-align:center;

    }

    .seccion-vino h2::after{

        margin:12px auto;

    }

    .mini-beneficios{

        grid-template-columns:
        repeat(2,1fr);

    }

    .grid-valores{

        grid-template-columns:1fr;

    }

    .beneficios-grid{

        grid-template-columns:1fr;

    }

    .contacto-grid{

        grid-template-columns:1fr;

    }

    .principio{

        gap:15px;

    }

    .principio-numero{

        min-width:58px;

        height:58px;

        font-size:13px;

    }

    .timeline::before{

        left:28px;

    }

    .principio-texto{

        padding:18px;

    }

    .llamada-final h2{

        font-size:30px;

    }

}




@media(max-width:480px){

    .logo{

        font-size:29px;

    }

    nav a{

